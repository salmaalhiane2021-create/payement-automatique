# ---------------------------------------------------------------------------
# Copiez ce fichier en « .env » puis adaptez les valeurs.
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS / Linux)
#
# ATTENTION : ne commitez JAMAIS le fichier .env (il contient des secrets).
# ---------------------------------------------------------------------------

# Environnement d'exécution : development | production
ENVIRONMENT=development

# Clé secrète servant à signer les jetons JWT et les codes OTP.
# En production : valeur aléatoire de 64 caractères minimum.
# Si laissée vide, une clé de développement est générée dans data/dev_secret.key
SECRET_KEY=

# Durée de vie du jeton de session (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Durée de vie du code de paiement à usage unique (secondes)
OTP_TTL_SECONDS=60

# Nombre d'essais autorisés pour saisir le code OTP
OTP_MAX_ATTEMPTS=3

# Seuils du moteur de risque (score de 0 à 100)
#   score <  RISK_ACCEPT_MAX  -> paiement accepté
#   score <  RISK_VERIFY_MAX  -> vérification supplémentaire (OTP + code PIN)
#   score >= RISK_VERIFY_MAX  -> paiement bloqué
RISK_ACCEPT_MAX=35
RISK_VERIFY_MAX=70

# Verrouillage du compte après N échecs de connexion
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Taux de contamination de l'Isolation Forest (proportion d'anomalies attendue)
ML_CONTAMINATION=0.04

# Base de données (laisser vide pour utiliser data/nexpay.db - SQLite)
DATABASE_URL=

# Fuseau horaire de référence pour l'analyse comportementale
APP_TIMEZONE=Europe/Paris

# Origines CORS autorisées (séparées par des virgules, * en développement)
CORS_ORIGINS=*
