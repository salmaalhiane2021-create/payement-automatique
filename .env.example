# ---------------------------------------------------------------------------
# Copiez ce fichier en « .env » puis adaptez les valeurs.
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS / Linux)
#
# ATTENTION : ne commitez JAMAIS le fichier .env (il contient des secrets).
# ---------------------------------------------------------------------------

# Environnement : development | production
# En production, le démarrage est refusé si SECRET_KEY est absente (ou trop
# courte) ou si CORS_ORIGINS contient « * » — voir app/config.py.
ENVIRONMENT=development

# --- Sécurité ---------------------------------------------------------------
# Clé de signature des jetons JWT et des codes OTP.
# En production : valeur aléatoire de 64 caractères minimum :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Si laissée vide en développement, une clé est générée dans data/dev_secret.key
SECRET_KEY=

# Durée de vie du jeton de session (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Verrouillage du compte après N échecs de connexion
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Longueur minimale des mots de passe
PASSWORD_MIN_LENGTH=8

# --- Réseau et déploiement --------------------------------------------------
# Interface d'écoute : 127.0.0.1 en local ; 0.0.0.0 derrière un reverse-proxy
# ou dans un conteneur (ne jamais exposer directement sans TLS).
HOST=127.0.0.1
PORT=8000

# Origines CORS autorisées, séparées par des virgules.
# Développement : vide = origines locales usuelles (ports 8000 et 8501).
# Production : vide = même origine uniquement ; « * » est refusé au démarrage.
CORS_ORIGINS=

# --- Paiement & authentification dynamique ----------------------------------
# Durée de vie du code de paiement à usage unique (secondes)
OTP_TTL_SECONDS=60

# Nombre d'essais autorisés pour saisir le code OTP
OTP_MAX_ATTEMPTS=3

# Bornes des paiements simulés
PAYMENT_MIN_AMOUNT=0.5
PAYMENT_MAX_AMOUNT=100000

# Seuils du moteur de risque (score de 0 à 100)
#   score <  RISK_ACCEPT_MAX  -> paiement accepté
#   score <  RISK_VERIFY_MAX  -> vérification supplémentaire (OTP + code PIN)
#   score >= RISK_VERIFY_MAX  -> paiement bloqué
RISK_ACCEPT_MAX=35
RISK_VERIFY_MAX=70

# --- International ----------------------------------------------------------
# Valeurs par défaut des nouveaux comptes (chaque utilisateur peut les changer
# depuis « Profil & région » ; aucune nationalité n'est collectée).
APP_TIMEZONE=Europe/Paris
DEFAULT_LOCALE=fr-FR
DEFAULT_CURRENCY=EUR

# Conversion de devises : DÉSACTIVÉE par défaut — aucun taux n'est inventé.
# Pour l'activer, fournissez une source fiable de taux pour 1 EUR :
#   FX_RATES_SOURCE=ex. « taux internes validés du 2026-10-19 »
#   FX_RATES_JSON={"USD": 1.08, "GBP": 0.85}
# Tant que ces variables sont vides, les interfaces affichent les montants en
# EUR en l'indiquant clairement.
FX_RATES_JSON=
FX_RATES_SOURCE=

# --- Base de données --------------------------------------------------------
# Laisser vide pour utiliser data/nexpay.db (SQLite, création automatique).
# Exemple PostgreSQL : postgresql+psycopg://utilisateur:motdepasse@localhost/nexpay
# Le schéma est versionné (Alembic) : python -m app.migrations
DATABASE_URL=

# --- Modèle Isolation Forest -------------------------------------------------
ML_CONTAMINATION=0.04

# Nombre minimal d'opérations pour entraîner le modèle
ML_MIN_SAMPLES=120

# Stockage des artefacts, partageable entre plusieurs instances :
#   file:///chemin/absolu   (défaut : app/ml/artifacts)
#   s3://bucket/prefix      (nécessite le paquet optionnel boto3)
MODEL_STORE_URI=

# Anti-emballement : délai minimal entre deux réentraînements (secondes)
ML_RETRAIN_MIN_INTERVAL_SECONDS=300

# Durée de vie du verrou d'entraînement (secondes), libéré automatiquement
ML_TRAINING_LOCK_TTL_SECONDS=900
